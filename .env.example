# SerpAPI key for Google Lens reverse-image search. Free tier: 100 searches/month.
# Sign up at https://serpapi.com/manage-api-key
SERPAPI_API_KEY=

# --- Polygon Amoy testnet (only needed for --chain amoy) ---
AMOY_RPC_URL=https://polygon-amoy-bor-rpc.publicnode.com

# Throwaway wallet private key -- generate with `python scripts/new_wallet.py`.
# NEVER put a real wallet's key here.
PRIVATE_KEY=

# --- Optional: permanently pin the full match record JSON to IPFS -----
# Free signup at https://pinata.cloud -> API Keys -> New Key -> copy the JWT.
# If unset, behavior is UNCHANGED from before this feature existed
# (uri = matched post link only). Purely additive.
PINATA_JWT=
